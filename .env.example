# ── LLM ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=changeme
LLM_MODEL=claude-sonnet-4-6
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192

# ── Embedding / Reranker ─────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_K=5

# ── Vector Store ─────────────────────────────────────────────────────────────
VECTOR_STORE_TYPE=chroma                      # chroma | qdrant
CHROMA_PERSIST_DIR=./knowledge_base/vector_store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_KNOWLEDGE=math_kb_knowledge
QDRANT_COLLECTION_PRACTICE=math_kb_practice

# ── Neo4j Knowledge Graph ─────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=math-to-go-dev
NEO4J_DATABASE=neo4j

# ── Retrieval ─────────────────────────────────────────────────────────────────
HYBRID_DENSE_TOP_K=10
HYBRID_SPARSE_TOP_K=10
RRF_K=60                                      # RRF rank constant
COLBERT_MATCH_THRESHOLD=0.75                  # UC-3 problem matching threshold

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ── Ebbinghaus ────────────────────────────────────────────────────────────────
MASTERY_THRESHOLD=3                           # consecutive correct answers to mark mastered
EBBINGHAUS_INTERVALS=1,2,4,7,15,30           # days between reviews

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:5173

# ── KB ───────────────────────────────────────────────────────────────────────
KB_DOCS_DIR=./knowledge_base/docs
KB_RAW_DIR=./knowledge_base/raw

# ── LangSmith (optional) ─────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=math-to-go

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
